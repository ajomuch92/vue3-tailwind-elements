{
  "name": "vue3-tailwind-elements",
  "private": false,
  "version": "0.0.18-beta",
  "author": {
    "name": "Aarón Montes"
  },
  "license": "MIT",
  "homepage": "https://vue-tailwind-elements.netlify.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajomuch92/vue3-tailwind-elements.git"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/vue3-tailwind-elements.umd.cjs",
  "module": "./dist/vue3-tailwind-elements.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3-tailwind-elements.js",
      "require": "./dist/vue3-tailwind-elements.umd.cjs"
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    },
    "./dist/plugin/index.js": {
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.js"
    },
    "./dist/plugin": {
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build && ncp ./src/plugin dist/plugin",
    "preview": "vite preview",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "ncp": "^2.0.0",
    "tailwindcss": "^3.3.1",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.3.10"
  },
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
