{
  "name": "vue3-tailwind-elements",
  "private": false,
  "version": "2.0.0",
  "author": {
    "name": "Aar\u00f3n Montes"
  },
  "license": "MIT",
  "homepage": "https://vue3-tailwind-elements-playground.pages.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajomuch92/vue3-tailwind-elements.git"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/vue3-tailwind-elements.umd.cjs",
  "module": "./dist/vue3-tailwind-elements.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3-tailwind-elements.js",
      "require": "./dist/vue3-tailwind-elements.umd.cjs"
    },
    "./dist/style.css": "./dist/vue3-tailwind-elements.css",
    "./css": "./dist/plugin/index.css",
    "./dist/plugin/index.css": "./dist/plugin/index.css",
    "./style.css": "./dist/vue3-tailwind-elements.css",
    "./dist/vue3-tailwind-elements.css": "./dist/vue3-tailwind-elements.css"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build && ncp ./src/plugin dist/plugin",
    "preview": "vite preview",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.11.2",
    "ncp": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.3.10"
  },
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "tailwind",
    "tailwindcss",
    "components",
    "ui",
    "typescript"
  ]
}
